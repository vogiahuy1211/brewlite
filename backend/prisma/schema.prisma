generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrderItemToppings {
  order_item_id     String     @db.Uuid
  topping_id        String     @db.Uuid
  price_at_purchase Decimal    @db.Decimal(12, 2)
  OrderItems        OrderItems @relation(fields: [order_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_oit_item")
  Toppings          Toppings   @relation(fields: [topping_id], references: [id], onUpdate: NoAction, map: "fk_oit_topping")

  @@id([order_item_id, topping_id])
}

model OrderItems {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id          String              @db.Uuid
  product_id        String              @db.Uuid
  size              item_size
  qty               Int
  unit_price        Decimal             @db.Decimal(12, 2)
  line_total        Decimal             @db.Decimal(12, 2)
  OrderItemToppings OrderItemToppings[]
  Orders            Orders              @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_orderitems_order")
  Products          Products            @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "fk_orderitems_product")
}

model Orders {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String       @db.Uuid
  promo_id        String?      @db.Uuid
  status          order_status @default(PENDING)
  subtotal        Decimal      @db.Decimal(12, 2)
  discount_amount Decimal      @default(0) @db.Decimal(12, 2)
  final_amount    Decimal      @db.Decimal(12, 2)
  created_at      DateTime     @default(now()) @db.Timestamp(6)
  OrderItems      OrderItems[]
  Promotions      Promotions?  @relation(fields: [promo_id], references: [id], onUpdate: NoAction, map: "fk_orders_promo")
  Users           Users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_orders_user")
  Payments        Payments[]
}

model Payments {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id        String         @db.Uuid
  idempotency_key String         @unique @db.VarChar(255)
  amount          Decimal        @db.Decimal(12, 2)
  method          payment_method
  status          payment_status
  Orders          Orders         @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payments_order")
}

model Products {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String       @db.VarChar(255)
  price      Decimal      @db.Decimal(12, 2)
  image_url  String?      @db.VarChar(500)
  stock      Int          @default(0)
  version    Int          @default(0)
  OrderItems OrderItems[]
}

model Promotions {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String    @unique @db.VarChar(50)
  discount_amount Decimal   @db.Decimal(12, 2)
  is_active       Boolean   @default(true)
  start_at        DateTime? @db.Timestamp(6)
  end_at          DateTime? @db.Timestamp(6)
  Orders          Orders[]
}

model Toppings {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @db.VarChar(255)
  price             Decimal             @db.Decimal(12, 2)
  OrderItemToppings OrderItemToppings[]
}

model Users {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String   @unique @db.VarChar(255)
  password_hash  String   @db.VarChar(255)
  loyalty_points Int      @default(0)
  Orders         Orders[]
}

enum item_size {
  S
  M
  L
}

enum order_status {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum payment_method {
  WALLET
  CARD
}

enum payment_status {
  SUCCESS
  FAILED
}
